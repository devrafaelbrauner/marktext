{
  "name": "@marktext-plus/mobile",
  "version": "0.21.0-dev",
  "private": true,
  "description": "MarkText Plus for Android: the desktop renderer inside a Capacitor WebView",
  "type": "module",
  "scripts": {
    "build:web": "vite build --config vite.web.config.ts",
    "sync": "pnpm build:web && cap sync android",
    "build:apk": "pnpm sync && cd android && ./gradlew assembleDebug",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "minimatch": "^9.0.9",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^22.20.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5"
  }
}
